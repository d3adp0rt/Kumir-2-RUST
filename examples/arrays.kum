| Сумма элементов массива и сортировка пузырьком
алг Массив
нач
    цел N = 6
    целтаб A[1:N] = {5, 3, 8, 1, 9, 2}
    цел i, j, c
    нц для i от 1 до N-1
        нц для j от 1 до N-i
            если A[j] > A[j+1] то
                c := A[j]
                A[j] := A[j+1]
                A[j+1] := c
            все
        кц
    кц
    нц для i от 1 до N
        вывод A[i], ' '
    кц
    вывод нс
кон
