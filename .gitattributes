# Normalize text files to LF in the repository.
* text=auto eol=lf

# Scripts and manifests
*.sh   text eol=lf
*.ps1  text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.kum  text eol=lf
*.fil  text eol=lf

# Binary assets
*.png      binary
*.ico      binary
*.icns     binary
*.jar      binary
*.aar      binary
*.apk      binary
*.aab      binary
*.idsig    binary
*.keystore binary
*.jks      binary
