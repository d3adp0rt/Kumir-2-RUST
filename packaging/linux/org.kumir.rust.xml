<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-kumir">
    <comment>Kumir program</comment>
    <comment xml:lang="ru">Программа КуМир</comment>
    <glob pattern="*.kum"/>
    <icon name="kumir-ide"/>
  </mime-type>
  <mime-type type="application/x-kumir-field">
    <comment>Kumir actor field</comment>
    <comment xml:lang="ru">Поле исполнителя КуМир</comment>
    <glob pattern="*.fil"/>
    <icon name="kumir-ide"/>
  </mime-type>
</mime-info>
