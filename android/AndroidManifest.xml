<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.kumir.rust">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

    <uses-feature android:glEsVersion="0x00020000" android:required="true"/>

    <application
        android:label="КуМир"
        android:icon="@drawable/ic_launcher"
        android:extractNativeLibs="true"
        android:theme="@style/KumirTheme">

        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:label="КуМир"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale"
            android:resizeableActivity="true">
            <meta-data android:name="android.app.lib_name" android:value="kumir_gui"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
